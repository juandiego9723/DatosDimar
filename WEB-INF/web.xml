	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
	version="4.0">

	<display-name>Datos Oceanográficos Dimar</display-name>

	<!-- Página de bienvenida -->
	<welcome-file-list>
		<welcome-file>/pages/seguridad/index.xhtml</welcome-file>
		<welcome-file>/sigSDGOConDatos/index.xhtml</welcome-file>
		<welcome-file>/sigSDGOAbiertos/index.xhtml</welcome-file>
		<welcome-file>/faces/index.xhtml</welcome-file>
	</welcome-file-list>

